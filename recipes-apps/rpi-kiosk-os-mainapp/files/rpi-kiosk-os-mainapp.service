[Unit]
Description=Kiosk UI
Documentation=https://bugfreeblog.duckdns.org/
StartLimitIntervalSec=20
StartLimitBurst=3
After=graphical.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/appRpiKioskOsMainApp
Environment="QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox"
Restart=on-failure

[Install]
WantedBy=graphical.target
